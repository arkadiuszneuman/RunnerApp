{
  "name": "runner-app",
  "private": true,
  "scripts": {
    "dev": "pnpm -F @runner/web dev",
    "build": "pnpm -F @runner/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm -F @runner/web storybook",
    "db:generate": "dotenv -e apps/web/.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e apps/web/.env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e apps/web/.env.local -- drizzle-kit studio"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
