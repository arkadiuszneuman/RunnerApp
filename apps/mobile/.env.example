# cp .env.example .env.local

# Base URL of the Next.js backend (apps/web). Use your machine's LAN IP, not
# localhost — a physical device or simulator can't reach your laptop's
# localhost. Example: http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth "Web" client — the SAME client id as AUTH_GOOGLE_ID in
# apps/web/.env.local. This is what actually matters: the Google ID token's
# `aud` claim is scoped to it regardless of platform, and it's what the
# backend verifies against (see apps/web/src/app/api/mobile/auth/google/route.ts).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth "iOS" client — a separate client registered for
# com.runnerapp.app in Google Cloud Console. Only drives the native iOS
# handshake; also update the iosUrlScheme in app.json's google-signin plugin
# config to match (reversed client id).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 1 = talk to FakeTreadmill (no hardware/BLE needed, used by the .maestro/
# e2e suite since emulators have no Bluetooth); unset or 0 = real
# react-native-ble-plx transport, requires a dev-client build (not Expo Go).
EXPO_PUBLIC_USE_FAKE_TREADMILL=1
