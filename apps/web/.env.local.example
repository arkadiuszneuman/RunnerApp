DATABASE_URL=postgresql://runner:runner@localhost:5433/runnerapp

AUTH_SECRET=<run: openssl rand -base64 32>
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=<your Google OAuth client ID>       # optional — skip to use email/password only
AUTH_GOOGLE_SECRET=<your Google OAuth client secret>

# Optional: key (32 bytes, base64 — `openssl rand -base64 32`) encrypting stored third-party credentials
# such as an intervals.icu API key. Without it one is derived from AUTH_SECRET (rotating AUTH_SECRET then
# means reconnecting).
# INTEGRATIONS_ENCRYPTION_KEY=
