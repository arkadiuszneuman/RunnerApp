# cp .env.local.example .env.local

DATABASE_URL=postgresql://runner:runner@localhost:5432/runnerapp

AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the mobile app's access tokens — separate from AUTH_SECRET so rotating
# one doesn't sign out the other. openssl rand -base64 32
MOBILE_JWT_SECRET=
