{
  "name": "@runner/android",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor Android shell for the RunnerApp web app — same UI (WebView), native BLE.",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "install:debug": "cd android && ./gradlew installDebug",
    "logcat": "adb logcat --pid=$(adb shell pidof -s com.runnerapp.app)"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "sharp": "^0.34.5"
  }
}
